{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "allowImportingTsExtensions": true,
    "paths": {
      "@phoenix/contracts": ["./packages/contracts/src/index.ts"],
      "@phoenix/toolkit": ["./packages/toolkit/src/index.ts"],
      "@phoenix/evidence": ["./packages/evidence/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
