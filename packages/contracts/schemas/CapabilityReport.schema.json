{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
    },
    "providerVersion": {
      "type": "string",
      "minLength": 1
    },
    "available": {
      "type": "boolean"
    },
    "supportedOperations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "inspect_target",
          "list_modules",
          "list_functions",
          "decompile_function",
          "get_references",
          "get_call_graph",
          "inspect_assets",
          "trace_runtime",
          "run_experiment",
          "capture_interface"
        ]
      }
    },
    "supportedKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "web",
          "electron",
          "source",
          "elf",
          "pe",
          "macho",
          "android",
          "dotnet",
          "wasm",
          "unknown"
        ]
      }
    },
    "needsRuntime": {
      "type": "boolean"
    },
    "supportedHosts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "windows",
          "macos",
          "linux"
        ]
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "satisfied": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "description",
          "satisfied"
        ],
        "additionalProperties": false
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "providerId",
    "providerVersion",
    "available",
    "supportedOperations",
    "supportedKinds",
    "needsRuntime",
    "supportedHosts",
    "prerequisites",
    "reasons"
  ],
  "additionalProperties": false,
  "$id": "https://phoenix.invalid/contracts/1.0.0-m0/CapabilityReport.schema.json",
  "$comment": "Generated from Zod. Custom refinements, including nested refinements, require runtime Zod validation."
}
