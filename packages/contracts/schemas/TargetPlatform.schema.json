{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "os": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "linux",
        "android",
        "freebsd",
        "any",
        "unknown"
      ]
    },
    "osBasis": {
      "type": "string",
      "enum": [
        "header",
        "assumed",
        "not-applicable"
      ]
    },
    "arches": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "x86",
          "x64",
          "arm",
          "arm64",
          "riscv64",
          "wasm32",
          "other",
          "unknown"
        ]
      }
    },
    "bitness": {
      "anyOf": [
        {
          "type": "number",
          "const": 32
        },
        {
          "type": "number",
          "const": 64
        }
      ]
    },
    "endianness": {
      "type": "string",
      "enum": [
        "little",
        "big"
      ]
    },
    "binaryType": {
      "type": "string",
      "enum": [
        "executable",
        "shared-library",
        "object",
        "core",
        "bundle",
        "unknown"
      ]
    }
  },
  "required": [
    "os",
    "osBasis",
    "arches"
  ],
  "additionalProperties": false,
  "$id": "https://phoenix.invalid/contracts/1.0.0-m0/TargetPlatform.schema.json",
  "$comment": "Generated from Zod. Custom refinements, including nested refinements, require runtime Zod validation."
}
