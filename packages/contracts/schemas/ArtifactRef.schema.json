{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^art_[0-9a-f]{32}$",
      "description": "ArtifactId"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mediaType": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "sha256",
    "sizeBytes",
    "mediaType"
  ],
  "additionalProperties": false,
  "$id": "https://phoenix.invalid/contracts/1.0.0-m0/ArtifactRef.schema.json",
  "$comment": "Generated from Zod. Custom refinements, including nested refinements, require runtime Zod validation."
}
