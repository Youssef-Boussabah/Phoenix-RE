{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^fnd_[0-9a-f]{32}$",
      "description": "FindingId"
    },
    "targetId": {
      "type": "string",
      "pattern": "^tgt_[0-9a-f]{32}$",
      "description": "TargetId"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "hypothesis",
        "observed",
        "corroborated",
        "contradicted"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^evr_[0-9a-f]{32}$",
            "description": "EvidenceRefId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "static",
              "runtime",
              "user",
              "derived"
            ]
          },
          "artifactId": {
            "type": "string",
            "pattern": "^art_[0-9a-f]{32}$",
            "description": "ArtifactId"
          },
          "location": {
            "type": "string"
          },
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "byte-range"
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "type",
                  "offset",
                  "length"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "path"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "x-phoenix-runtime-constraints": "NFC, well-formed Unicode, POSIX relative path; no absolute paths, empty/dot segments, NUL or backslashes"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "address"
                  },
                  "address": {
                    "type": "string"
                  },
                  "space": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "address"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "event"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "type",
                  "sequence"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "region"
                  },
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            ]
          },
          "observationId": {
            "type": "string",
            "pattern": "^obs_[0-9a-f]{32}$",
            "description": "ObservationId"
          }
        },
        "required": [
          "id",
          "kind",
          "artifactId"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "author": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "intake",
            "provider",
            "user",
            "model"
          ]
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "targetId",
    "statement",
    "status",
    "evidence",
    "limitations",
    "revision",
    "author",
    "createdAt"
  ],
  "additionalProperties": false,
  "$id": "https://phoenix.invalid/contracts/1.0.0-m0/Finding.schema.json",
  "x-phoenix-runtime-constraints": "non-hypotheses require evidence",
  "$comment": "Generated from Zod. Custom refinements, including nested refinements, require runtime Zod validation."
}
